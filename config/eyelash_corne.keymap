#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <120>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <150>;
            hold-trigger-key-positions = <7 8 9 11 10 12 27 41 40 39 38 37 36 22 23 24 25 26>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <120>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <150>;
            hold-trigger-key-positions = <0 1 5 13 14 15 16 17 18 28 29 30 31 32 33 0 1 2 3 4 5 13 14 15 16 17 18>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos { compatible = "zmk,combos"; };

    macros {
        arrowrs: arrowrs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "ARROWRS";
        };

        arrowjs: arrowjs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
            label = "ARROWJS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&none  &kp Q            &kp W            &kp E              &kp R         &kp T                                &kp C_NEXT                    &kp Y  &kp U         &kp I              &kp O            &kp P                    &none
&none  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_SHIFT D  &hml LCTRL F  &kp G                &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp H  &hmr LCTRL J  &hmr LEFT_SHIFT K  &hmr LEFT_ALT L  &hmr LEFT_GUI SEMICOLON  &none
&none  &mt LCTRL Z      &kp X            &kp C              &kp V         &kp B  &kp C_MUTE                    &kp C_PREVIOUS                &kp N  &kp M         &kp COMMA          &kp DOT          &kp FSLH                 &none
                                         &kp ESC            &kp BSPC      &mo 1                                                              &mo 2  &kp SPACE     &kp RET
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &trans          &kp N6                &kp N7          &kp N8           &kp N9    &kp N0     &none
&none  &none   &none   &none   &none   &none             &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LBKT  &kp RBKT   &kp RIGHT_PARENTHESIS
&none  &none   &none   &none   &none   &none   &trans            &trans          &none                 &kp UNDERSCORE  &kp MINUS        &kp PLUS  &kp EQUAL  &none
                       &none   &none   &none                                     &mo 3                 &kp TAB         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&none         &kp EXCL  &kp AT     &kp HASH          &kp DLLR           &kp PRCNT                    &trans          &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR  &none
&none         &none     &kp GRAVE  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp TILDE            &trans  &trans  &trans  &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &none     &none
&kp CAPSLOCK  &arrowrs  &arrowjs   &kp PIPE          &kp BACKSLASH      &none      &trans            &trans          &none      &none     &none      &none      &none     &none
                                   &none             &kp DEL            &mo 3                                        &none      &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&none  &kp N1           &kp N2           &kp N3        &kp N4        &kp N5                         &trans          &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &none
&none  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR             &trans  &trans  &trans  &none   &kp LCTRL  &kp LSHFT  &kp LALT  &kp LGUI  &none
&none  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &none         &sys_reset    &bootloader  &trans            &trans          &none   &none      &none      &none     &kp CAPS  &none
                                         &none         &none         &none                                          &none   &none      &none
            >;

            sensor-bindings = <&rgb_encoder>;
        };
    };
};
