#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&none      &kp Q           &kp W           &kp E             &kp R        &kp T                                &kp K_NEXT                    &kp Y  &kp U        &kp I             &kp O           &kp P                   &kp MINUS
&kp GRAVE  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &kp G                &kp K_PREVIOUS  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp H  &mt LCTRL J  &mt LEFT_SHIFT K  &mt LEFT_ALT L  &mt LEFT_GUI SEMICOLON  &kp SINGLE_QUOTE
&none      &mt LCTRL Z     &kp X           &kp C             &kp V        &kp B  &kp C_MUTE                    &kp K_PREVIOUS                &kp N  &kp M        &kp COMMA         &kp DOT         &kp FSLH                &kp EQUAL
                                           &kp ESC           &kp BSPC     &mo 1                                                              &mo 2  &kp SPACE    &kp RET
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &trans          &kp N6  &kp N7          &kp N8           &kp N9    &kp N0     &none
&none  &none   &none   &none   &none   &none             &trans  &trans  &trans  &none   &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LBKT  &kp RBKT   &none
&none  &none   &none   &none   &none   &none   &trans            &trans          &none   &kp UNDERSCORE  &kp MINUS        &kp PLUS  &kp EQUAL  &none
                       &none   &none   &none                                     &mo 3   &kp TAB         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&none  &kp EXCL  &kp AT  &kp HASH      &kp DLLR  &kp PRCNT                             &trans          &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR  &none
&none  &none     &none   &kp LS(PIPE)  &kp BSLH  &none                         &trans  &trans  &trans  &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &none     &none
&none  &kp CAPS  &none   &none         &none     &none      &kp PRINTSCREEN            &trans          &none      &none     &none      &none      &none     &none
                         &none         &kp DEL   &mo 3                                                 &none      &none     &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&none  &kp N1           &kp N2           &kp N3        &kp N4        &kp N5                         &trans          &kp N6       &kp N7     &kp N8       &kp N9      &kp N0    &none
&none  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR             &trans  &trans  &trans  &bootloader  &kp LCTRL  &kp LSHFT    &kp LALT    &kp LGUI  &none
&none  &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &none         &sys_reset    &bootloader  &trans            &trans          &none        &none      &bootloader  &sys_reset  &kp CAPS  &none
                                         &none         &none         &none                                          &none        &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };
};
